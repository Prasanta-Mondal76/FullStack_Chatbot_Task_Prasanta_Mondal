# Copy this file to .env and fill in your values. Never commit .env to git.
PORT=5000
# Local MongoDB (default) — or paste your MongoDB Atlas connection string here
MONGODB_URI=mongodb://127.0.0.1:27017/dronetv_assistant
# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173
# Secret key for the admin dashboard (required for reading/updating/deleting
# enquiries). Pick a long random value and keep it private.
ADMIN_API_KEY=change-me-to-a-long-random-secret
